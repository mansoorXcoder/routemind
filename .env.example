# AI Providers Config
AI_PROVIDER=google  # google or openrouter
GOOGLE_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
AI_MODEL_ROUTINE=gemini-2.5-flash
AI_MODEL_REASONING=gemini-2.5-flash

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/routemind
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRE_MINUTES=1440

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=routemind-reports

# Next.js Config (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=RouteMind

# General Config
APP_ENV=development
LOG_LEVEL=INFO
